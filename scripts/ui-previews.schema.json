{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.sdk.fdo.alexvwan.me/schemas/ui-previews/1.0.0",
  "title": "FDO SDK static component previews",
  "type": "object",
  "required": [
    "contractVersion",
    "componentContractVersion",
    "cases"
  ],
  "properties": {
    "contractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "componentContractVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "identity",
          "state",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "pattern": "^fdo\\."
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "properties": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
